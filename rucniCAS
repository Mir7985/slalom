<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ruční měření</title>
  <style>
    body { font-family: sans-serif; padding: 20px; max-width: 400px; margin: 0 auto; background-color: #f9f9f9; }
    h2 { text-align: center; color: #333; }
    .form-group { margin-bottom: 20px; }
    label { display: block; margin-bottom: 5px; font-weight: bold; color: #555; }
    input { width: 100%; padding: 12px; font-size: 18px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 6px; }
    
    /* Styl pro velká přepínací tlačítka Start/Cíl */
    .type-selector { display: flex; gap: 10px; margin-bottom: 20px; }
    .type-option { flex: 1; text-align: center; }
    .type-option input { display: none; } /* Schováme původní puntík */
    .type-option label {
      display: block; padding: 15px; background-color: #fff; border: 2px solid #ccc;
      border-radius: 6px; cursor: pointer; font-size: 18px; font-weight: bold; transition: all 0.2s;
    }
    /* Barva pro aktivní START */
    #typ_start:checked + label { background-color: #007bff; color: white; border-color: #0056b3; }
    /* Barva pro aktivní CÍL */
    #typ_cil:checked + label { background-color: #dc3545; color: white; border-color: #bd2130; }

    button { width: 100%; padding: 15px; font-size: 18px; font-weight: bold; cursor: pointer; border-radius: 6px; border: none; background-color: #28a745; color: white; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    button:active { transform: scale(0.98); }
    #status { margin-top: 15px; padding: 12px; text-align: center; font-weight: bold; border-radius: 6px; display: none; }
  </style>
</head>
<body>

  <h2>Ruční zápis času</h2>
  
  <div class="form-group">
    <label>Typ měření:</label>
    <div class="type-selector">
      <div class="type-option">
        <input type="radio" id="typ_start" name="typ_mereni" value="START" checked>
        <label for="typ_start">START</label>
      </div>
      <div class="type-option">
        <input type="radio" id="typ_cil" name="typ_mereni" value="CÍL">
        <label for="typ_cil">CÍL</label>
      </div>
    </div>
  </div>

  <div class="form-group">
    <label for="st_cislo">Startovní číslo:</label>
    <input type="number" id="st_cislo" pattern="[0-9]*" inputmode="numeric" placeholder="Např. 42">
  </div>

  <div class="form-group">
    <label for="cas_stopek">Čas ze stopek (jen číslice):</label>
    <input type="text" id="cas_stopek" pattern="[0-9]*" inputmode="numeric" placeholder="HHMMSSmm">
  </div>

  <button onclick="odeslatData()">Uložit a odeslat</button>
  <div id="status"></div>

  <script>
    // Automatická vstupní maska pro dvojtečky a tečku
    document.getElementById('cas_stopek').addEventListener('input', function (e) {
      var x = e.target.value.replace(/\D/g, '').match(/(\d{0,2})(\d{0,2})(\d{0,2})(\d{0,2})/);
      if (!x[2]) { e.target.value = x[1]; } 
      else if (!x[3]) { e.target.value = x[1] + ':' + x[2]; } 
      else if (!x[4]) { e.target.value = x[1] + ':' + x[2] + ':' + x[3]; } 
      else { e.target.value = x[1] + ':' + x[2] + ':' + x[3] + ',' + x[4]; }
    });

    function odeslatData() {
      var stCislo = document.getElementById('st_cislo').value;
      var casStopek = document.getElementById('cas_stopek').value;
      var statusDiv = document.getElementById('status');
      
      // Zjištění, která možnost je vybraná (START nebo CÍL)
      var typMereni = document.querySelector('input[name="typ_mereni"]:checked').value;

      if(!stCislo || !casStopek) {
        alert('Vyplňte prosím startovní číslo i čas!');
        return;
      }

      statusDiv.style.display = 'block';
      statusDiv.style.backgroundColor = '#eee';
      statusDiv.style.color = '#333';
      statusDiv.innerText = 'Odesílám...';

      // Volání Google skriptu na serveru s novým parametrem typMereni
      google.script.run
        .withSuccessHandler(function() {
          statusDiv.style.backgroundColor = '#d4edda';
          statusDiv.style.color = '#155724';
          statusDiv.innerText = 'Uloženo jako ' + typMereni + '!';
          
          // Vyčištění polí a vrácení kurzoru
          document.getElementById('st_cislo').value = '';
          document.getElementById('cas_stopek').value = '';
          document.getElementById('st_cislo').focus();
        })
        .withFailureHandler(function(err) {
          statusDiv.style.backgroundColor = '#f8d7da';
          statusDiv.style.color = '#721c24';
          statusDiv.innerText = 'Chyba: ' + err;
        })
        .ulozRucniCas(stCislo, casStopek, typMereni); // Posíláme i informaci o Startu/Cíli
    }
  </script>
</body>
</html>
